const EH=['ID','Arrangement','Dato','Tid','Sted','Frist (dato inkl.)','Kapacitet','Åben'];
const RH=['ID','Arrangement-ID','Navn','E-mail','Antal','Status','Oprettet','Afmeldingskode','Mailstatus'];
function props_(){return PropertiesService.getScriptProperties()}
function book_(){return SpreadsheetApp.openById(props_().getProperty('SHEET_ID'))}
function sheet_(n){return book_().getSheetByName(n)}
function rows_(n){return sheet_(n).getDataRange().getDisplayValues().slice(1)}
function today_(){return Utilities.formatDate(new Date(),'Europe/Copenhagen','yyyy-MM-dd')}
function shift_(s,n){let d=new Date(s+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+n);return d.toISOString().slice(0,10)}
function onOpen(){SpreadsheetApp.getUi().createMenu('Marineforeningen').addItem('Klargør register','setupRegister_').addItem('Tilføj kommende lørdage','addLunches_').addItem('Manuel tilmelding','manualSignup_').addItem('Afmeld valgt række','adminCancel_').addItem('Send / gensend mail for valgt række','adminMail_').addItem('Vis deltagerliste','showParticipants_').addToUi()}
function setupRegister_(){let b=SpreadsheetApp.getActiveSpreadsheet();props_().setProperty('SHEET_ID',b.getId());b.setSpreadsheetTimeZone('Europe/Copenhagen');for(let [n,h] of [['Arrangementer',EH],['Tilmeldinger',RH]]){let s=b.getSheetByName(n)||b.insertSheet(n);if(s.getLastRow()===0){s.getRange(1,1,1,h.length).setValues([h]).setBackground('#092a3d').setFontColor('#ffffff').setFontWeight('bold');s.setFrozenRows(1);s.getRange(2,1,s.getMaxRows()-1,h.length).setNumberFormat('@');s.autoResizeColumns(1,h.length)}}let s=b.getSheetByName('Arrangementer');if(s.getLastRow()===1){s.getRange(2,1,SEED.length,8).setValues(SEED)}addLunches_();}
function addLunches_(){let s=sheet_('Arrangementer'),ids=new Set(rows_('Arrangementer').map(r=>r[0])),d=today_();for(let i=0;i<112;i++){let day=shift_(d,i);if(new Date(day+'T12:00:00Z').getUTCDay()!==6)continue;let id='loerdagsfrokost-'+day;if(!ids.has(id))s.appendRow([id,'Lørdagsfrokost'+(Number(day.slice(-2))<=7?' · udvidet menu':''),day,'11.30','Marinestuen',shift_(day,-2),'','NEJ'])}}
function event_(id){return rows_('Arrangementer').find(r=>r[0]===id)}
function validEvent_(e){return e&&e[7]==='JA'&&/^\d{4}-\d{2}-\d{2}$/.test(e[2])&&/^\d{4}-\d{2}-\d{2}$/.test(e[5])&&e[2]>=today_()&&e[5]>=today_()&&e[5]<=e[2]&&(!e[6]||/^[1-9]\d*$/.test(e[6]))}
function safe_(v){return /^[=+\-@\t\r]/.test(v)?"'"+v:v}
function locked_(fn){let l=LockService.getScriptLock();l.waitLock(10000);try{return fn()}finally{l.releaseLock()}}
function doGet(e){let t=HtmlService.createTemplateFromFile('Form');t.eventId=String(e.parameter.event||'');t.token=String(e.parameter.cancel||'');return t.evaluate().setTitle('Ebeltoft Marineforening – tilmelding')}
function publicEvent(id){let e=event_(String(id));if(!validEvent_(e))return {open:false};let used=rows_('Tilmeldinger').filter(r=>r[1]===id&&r[5]==='TILMELDT').reduce((a,r)=>a+Number(r[4]),0);return {open:true,title:e[1],date:e[2],time:e[3],place:e[4],deadline:e[5],left:e[6]?Math.max(0,Number(e[6])-used):null}}
function register(data){return register_(data,false)}
function register_(data,manual){let id=String(data.id||''),name=String(data.name||'').trim(),email=String(data.email||'').trim().toLowerCase(),n=Number(data.count);if(!name||name.length>100||email.length>254||(!manual||email)&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)||!Number.isInteger(n)||n<1||n>20)throw Error('Kontrollér navn, e-mail og antal (1–20).');let r=locked_(()=>{let e=event_(id);if(!validEvent_(e))throw Error('Tilmelding er lukket eller ikke åbnet endnu.');let all=rows_('Tilmeldinger'),active=all.filter(x=>x[1]===id&&x[5]==='TILMELDT');if(email&&active.some(x=>x[3]===email))return null;if(!email&&active.some(x=>x[2]===name))return null;let used=active.reduce((a,x)=>a+Number(x[4]),0);if(e[6]&&used+n>Number(e[6]))throw Error('Der er ikke nok ledige pladser.');let r=[Utilities.getUuid(),id,safe_(name),safe_(email),String(n),'TILMELDT',new Date().toISOString(),Utilities.getUuid()+Utilities.getUuid(),email?'AFVENTER':'INGEN MAIL'];sheet_('Tilmeldinger').appendRow(r);SpreadsheetApp.flush();return r});if(!r)return {ok:false,message:'Der findes allerede en tilmelding med disse oplysninger. Kontakt foreningen ved ændringer.'};let mail=email?sendMail_(r[0]):false;return {ok:true,message:mail?'Du er tilmeldt. Bekræftelsesmail er sendt til afsendelse.':'Du er tilmeldt. '+(email?'Mailen kunne ikke sendes nu; kontakt foreningen ved behov.':'')};}
function cancelInfo(token){if(!/^[a-f0-9-]{72}$/i.test(token))return {ok:false};let r=rows_('Tilmeldinger').find(x=>x[7]===token);let e=r&&event_(r[1]);return r&&e&&r[5]==='TILMELDT'&&e[2]>=today_()?{ok:true,title:e[1],date:e[2],count:r[4]}:{ok:false}}
function cancelRegistration(token){if(!/^[a-f0-9-]{72}$/i.test(token))return {ok:false};let r=locked_(()=>{let all=rows_('Tilmeldinger'),i=all.findIndex(x=>x[7]===token&&x[5]==='TILMELDT');if(i<0)return null;let e=event_(all[i][1]);if(!e||e[2]<today_())return null;sheet_('Tilmeldinger').getRange(i+2,6).setValue('AFMELDT');sheet_('Tilmeldinger').getRange(i+2,9).setValue('AFVENTER');SpreadsheetApp.flush();return all[i]});if(!r)return {ok:false};return {ok:true,mail:sendMail_(r[0])}}
function sendMail_(id){return locked_(()=>{let all=rows_('Tilmeldinger'),i=all.findIndex(x=>x[0]===id);if(i<0)return false;let r=all[i],e=event_(r[1]),p=props_(),key=p.getProperty('BREVO_API_KEY'),sender=p.getProperty('BREVO_SENDER'),url=p.getProperty('WEBAPP_URL'),cell=sheet_('Tilmeldinger').getRange(i+2,9);if(!r[3]||!e||!key||!sender||!url){cell.setValue('MANGLER OPSÆTNING / MAIL');return false}let day=today_(),counter='MAIL_'+day,n=Number(p.getProperty(counter)||0);if(n>=280){cell.setValue('DAGSGRÆNSE – GENSEND');return false}p.setProperty(counter,String(n+1));let cancelled=r[5]==='AFMELDT',subject=(cancelled?'Afmelding: ':'Tilmelding: ')+e[1],text=(cancelled?'Din afmelding er registreret.':'Du er tilmeldt.')+'\n'+e[1]+'\n'+e[2]+' · '+e[3]+' · '+e[4]+'\nAntal: '+r[4]+(cancelled?'':'\nAfmeld her: '+url+'?cancel='+encodeURIComponent(r[7]))+'\n\nEbeltoft Marineforening';try{let res=UrlFetchApp.fetch('https://api.brevo.com/v3/smtp/email',{method:'post',contentType:'application/json',headers:{'api-key':key},payload:JSON.stringify({sender:{name:'Ebeltoft Marineforening',email:sender},to:[{email:r[3]}],subject:subject,textContent:text}),muteHttpExceptions:true});let ok=res.getResponseCode()>=200&&res.getResponseCode()<300;cell.setValue(ok?'ACCEPTERET AF BREVO':'MAILFEJL – GENSEND');return ok}catch(err){cell.setValue('MAILFEJL – GENSEND');return false}})}
// Admin functions are private to the script editor / spreadsheet menu. Public HTML never calls them.
function adminRow_(){let s=SpreadsheetApp.getActiveSheet(),i=s.getActiveRange().getRow();if(s.getName()!=='Tilmeldinger'||i<2)throw Error('Vælg en række i Tilmeldinger.');return {s:s,i:i,r:s.getRange(i,1,1,9).getDisplayValues()[0]}}
function manualSignup_(){let ui=SpreadsheetApp.getUi(),a=ui.prompt('Manuel tilmelding','Arrangement-ID | navn | e-mail (valgfri) | antal',ui.ButtonSet.OK_CANCEL);if(a.getSelectedButton()!==ui.Button.OK)return;let [id,name,email,count]=a.getResponseText().split('|').map(x=>x.trim());ui.alert(register_({id,name,email,count},true).message)}
function adminCancel_(){let a=adminRow_(),ui=SpreadsheetApp.getUi();if(ui.alert('Afmeld valgt tilmelding?',ui.ButtonSet.YES_NO)!==ui.Button.YES)return;let r=cancelRegistration(a.r[7]);ui.alert(r.ok?'Afmeldt':'Ikke afmeldt')}
function adminMail_(){let a=adminRow_();SpreadsheetApp.getUi().alert(sendMail_(a.r[0])?'Accepteret af Brevo':'Ikke sendt – se mailstatus')}
function showParticipants_(){let ui=SpreadsheetApp.getUi(),a=ui.prompt('Deltagerliste','Indtast arrangement-ID',ui.ButtonSet.OK_CANCEL);if(a.getSelectedButton()!==ui.Button.OK)return;let id=a.getResponseText().trim(),e=event_(id);if(!e){ui.alert('Ukendt arrangement');return}let b=book_(),s=b.getSheetByName('Deltagerliste')||b.insertSheet('Deltagerliste');s.clearContents();let r=rows_('Tilmeldinger').filter(x=>x[1]===id&&x[5]==='TILMELDT');s.getRange(1,1,1,3).setValues([[e[1],e[2],'Antal: '+r.reduce((n,x)=>n+Number(x[4]),0)]]);s.getRange(2,1,1,3).setValues([['Navn','E-mail','Antal']]);if(r.length)s.getRange(3,1,r.length,3).setValues(r.map(x=>[safe_(x[2]),safe_(x[3]),x[4]]));s.autoResizeColumns(1,3);b.setActiveSheet(s)}

const SEED=[["kam-2026-11", "Kammeratskabsaften", "2026-11-26", "Tidspunkt følger", "Marinestuen", "", "", "NEJ"], ["jul-2026", "Julemakkerskydning", "2026-12-09", "Tidspunkt følger", "Ebeltoft Marineforening", "", "", "NEJ"], ["kam-2027-01", "Kammeratskabsaften", "2027-01-28", "Tidspunkt følger", "Marinestuen", "", "", "NEJ"], ["generalforsamling-2027", "Generalforsamling", "2027-02-25", "Tidspunkt følger", "Marinestuen", "", "", "NEJ"], ["foedselsdag-2027", "Marineforeningens 110-års fødselsdag", "2027-02-28", "Tidspunkt følger", "Ebeltoft Marineforening", "", "", "NEJ"], ["kam-2027-03", "Kammeratskabsaften", "2027-03-25", "Tidspunkt følger", "Marinestuen", "", "", "NEJ"], ["kam-2027-04", "Kammeratskabsaften med ledsager", "2027-04-29", "Tidspunkt følger", "Marinestuen", "", "", "NEJ"]];
